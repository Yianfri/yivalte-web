import QuoteBuilder from "../components/sections/QuoteBuilder.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Yivalte — Estampados personalizados DTF";
---

<BaseLayout
  title={pageTitle}
  description="Estampados DTF personalizados para poleras, polerones y textiles. Cotiza tu diseño con Yivalte."
>
  <main>
    <Hero />
    <ProductCatalog />
    <HowToOrder />
    <QuoteBuilder />
