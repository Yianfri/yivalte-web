<div
  id="probador"
  class="design-preview flex min-h-[39rem] flex-col overflow-hidden bg-[#ded9cf] text-neutral-950 lg:min-h-full"
  data-design-preview
>
  <div class="flex items-start justify-between gap-5 px-5 pt-6 sm:px-8 sm:pt-8">
    <div>
      <p class="text-[0.65rem] font-black uppercase tracking-[0.22em] text-[#ef4b32]">Arma una referencia</p>
      <p class="mt-1 text-sm text-neutral-700">Prueba color, lado y tamaño antes de cotizar.</p>
    </div>
    <p class="max-w-32 text-right text-[0.62rem] font-bold uppercase leading-4 tracking-[0.14em] text-neutral-500">
      No reemplaza la muestra final
    </p>
  </div>

  <div class="relative flex min-h-[27rem] flex-1 items-center justify-center overflow-hidden px-10 py-3 sm:px-16">
    <div class="absolute left-0 top-[28%] h-px w-10 bg-[#ef4b32] sm:w-16"></div>
    <div class="absolute bottom-[18%] right-0 h-px w-12 bg-neutral-950 sm:w-20"></div>

    <div class="garment-window relative aspect-[3/4] h-[25rem] max-h-full overflow-hidden sm:h-[29rem]">
      <img
        class="garment-sprite pointer-events-none h-full max-w-none transition-[transform,filter] duration-500 ease-out"
        data-garment-sprite
        src="/products/tshirt-views-v2.webp"
        alt="Polera negra vista de frente"
        width="1536"
        height="1024"
      />

      <div class="pointer-events-none absolute left-1/2 top-[28%] flex h-[38%] w-[38%] -translate-x-1/2 items-start justify-center overflow-hidden">
        <img
          class="mt-[8%] max-h-full w-[58%] object-contain transition-[width,filter] duration-200"
          data-preview-art
          data-default-art="true"
          src="/brand/yivalte-wordmark.svg"
          alt="Diseño Yivalte aplicado a la polera"
        />
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-950/15 bg-[#f4f1e9] px-5 py-5 sm:px-8">
    <div class="grid gap-x-7 gap-y-5 sm:grid-cols-[auto_auto_1fr] sm:items-end">
      <fieldset>
        <legend class="mb-2 text-[0.62rem] font-black uppercase tracking-[0.16em] text-neutral-500">Prenda</legend>
        <div class="flex gap-2">
          <button
            class="h-7 w-7 rounded-full border border-neutral-400 bg-[#ede8db] outline outline-2 outline-offset-2 outline-transparent"
            type="button"
            data-shirt-color="crudo"
            aria-label="Polera cruda"
            aria-pressed="false"
          ></button>
          <button
            class="h-7 w-7 rounded-full border border-neutral-950 bg-neutral-900 outline outline-2 outline-offset-2 outline-[#ef4b32]"
            type="button"
            data-shirt-color="negro"
            aria-label="Polera negra"
            aria-pressed="true"
          ></button>
          <button
            class="h-7 w-7 rounded-full border border-[#9d3527] bg-[#b74030] outline outline-2 outline-offset-2 outline-transparent"
            type="button"
            data-shirt-color="rojo"
            aria-label="Polera roja"
            aria-pressed="false"
          ></button>
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-2 text-[0.62rem] font-black uppercase tracking-[0.16em] text-neutral-500">Lado</legend>
        <div class="flex gap-4 text-sm font-bold">
          <button class="border-b-2 border-neutral-950 pb-1" type="button" data-shirt-side="front" aria-pressed="true">
            Frente
          </button>
          <button class="border-b-2 border-transparent pb-1 text-neutral-500" type="button" data-shirt-side="back" aria-pressed="false">
            Espalda
          </button>
        </div>
      </fieldset>

      <label class="block text-[0.62rem] font-black uppercase tracking-[0.16em] text-neutral-500">
        Tamaño
        <input
          class="mt-3 block w-full accent-[#ef4b32]"
          type="range"
          min="32"
          max="92"
          value="58"
          data-print-size
          aria-label="Tamaño del estampado en la polera"
        />
      </label>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <label class="inline-flex min-h-11 cursor-pointer items-center justify-center border border-neutral-950 bg-white px-4 py-2 text-sm font-black transition-colors hover:bg-neutral-950 hover:text-white">
        Elegir diseño
        <input class="sr-only" type="file" accept="image/png,image/jpeg,image/webp" data-art-upload />
      </label>
      <button class="hidden min-h-11 px-2 py-2 text-sm font-bold text-neutral-600 hover:text-neutral-950" type="button" data-reset-art>
        Quitar
      </button>
      <a
        class="ml-auto inline-flex min-h-11 items-center bg-neutral-950 px-4 py-2 text-sm font-black text-white transition-colors hover:bg-[#ef4b32]"
        href="#cotizador"
        data-preview-to-quote
      >
        Cotizar esta idea →
      </a>
    </div>
    <p class="mt-3 text-xs leading-5 text-neutral-500" data-preview-status role="status" aria-live="polite">
      Usa PNG transparente para que el estampado no quede con un recuadro.
    </p>
  </div>
</div>

<script>
  const previewRoot = document.querySelector("[data-design-preview]");

  if (previewRoot instanceof HTMLElement) {
    const garment = previewRoot.querySelector("[data-garment-sprite]");
    const artwork = previewRoot.querySelector("[data-preview-art]");
    const upload = previewRoot.querySelector("[data-art-upload]");
    const reset = previewRoot.querySelector("[data-reset-art]");
    const size = previewRoot.querySelector("[data-print-size]");
    const status = previewRoot.querySelector("[data-preview-status]");
    const quoteLink = previewRoot.querySelector("[data-preview-to-quote]");
    const defaultArtwork = "/brand/yivalte-wordmark.svg";
    let objectUrl = "";
    let selectedColor = "negro";
    let selectedSide = "Frente";

    const garmentFilters = {
      crudo: "none",
      negro: "brightness(0.2) contrast(1.22)",
      rojo: "sepia(1) saturate(2.8) hue-rotate(325deg) brightness(0.68) contrast(1.05)",
    };

    const updateDefaultArtwork = () => {
      if (!(artwork instanceof HTMLImageElement) || artwork.dataset.defaultArt !== "true") return;
      artwork.style.filter = selectedColor === "crudo" ? "brightness(0)" : "none";
    };

    previewRoot.querySelectorAll("[data-shirt-color]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement) || !(garment instanceof HTMLImageElement)) return;
        selectedColor = button.dataset.shirtColor || "crudo";
        garment.style.filter = garmentFilters[selectedColor] || "none";
        garment.alt = `Polera ${selectedColor} vista de ${selectedSide.toLowerCase()}`;

        previewRoot.querySelectorAll("[data-shirt-color]").forEach((item) => {
          const active = item === button;
          item.setAttribute("aria-pressed", String(active));
          item.classList.toggle("outline-[#ef4b32]", active);
          item.classList.toggle("outline-transparent", !active);
        });
        updateDefaultArtwork();
      });
    });

    previewRoot.querySelectorAll("[data-shirt-side]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement) || !(garment instanceof HTMLImageElement)) return;
        const isBack = button.dataset.shirtSide === "back";
        selectedSide = isBack ? "Espalda" : "Frente";
        garment.style.transform = isBack ? "translateX(-50%)" : "translateX(0)";
        garment.alt = `Polera ${selectedColor} vista de ${isBack ? "espalda" : "frente"}`;

        previewRoot.querySelectorAll("[data-shirt-side]").forEach((item) => {
          const active = item === button;
          item.setAttribute("aria-pressed", String(active));
          item.classList.toggle("border-neutral-950", active);
          item.classList.toggle("border-transparent", !active);
          item.classList.toggle("text-neutral-500", !active);
        });
      });
    });

    if (size instanceof HTMLInputElement && artwork instanceof HTMLImageElement) {
      size.addEventListener("input", () => {
        artwork.style.width = `${size.value}%`;
      });
    }

    if (
      upload instanceof HTMLInputElement &&
      artwork instanceof HTMLImageElement &&
      reset instanceof HTMLButtonElement &&
      status instanceof HTMLElement
    ) {
      upload.addEventListener("change", () => {
        const file = upload.files?.[0];
        if (!file) return;

        if (!(["image/png", "image/jpeg", "image/webp"].includes(file.type)) || file.size > 10 * 1024 * 1024) {
          upload.value = "";
          status.textContent = "Usa un PNG, JPG o WebP de máximo 10 MB.";
          return;
        }

        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = URL.createObjectURL(file);
        artwork.src = objectUrl;
        artwork.dataset.defaultArt = "false";
        artwork.style.filter = "none";
        artwork.alt = `Diseño ${file.name} aplicado a la polera`;
        reset.classList.remove("hidden");
        status.textContent = `${file.name} listo. Para un mejor resultado, usa fondo transparente.`;
      });

      reset.addEventListener("click", () => {
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = "";
        upload.value = "";
        artwork.src = defaultArtwork;
        artwork.dataset.defaultArt = "true";
        artwork.alt = "Diseño Yivalte aplicado a la polera";
        artwork.style.width = "58%";
        if (size instanceof HTMLInputElement) size.value = "58";
        reset.classList.add("hidden");
        status.textContent = "Usa PNG transparente para que el estampado no quede con un recuadro.";
        updateDefaultArtwork();
      });
    }

    quoteLink?.addEventListener("click", () => {
      const form = document.querySelector("#cotizador-form");
      if (!(form instanceof HTMLFormElement)) return;
      const colorField = form.elements.namedItem("color");
      const locationField = form.elements.namedItem("location");
      const designField = form.elements.namedItem("design");
      if (colorField instanceof HTMLInputElement) colorField.value = selectedColor;
      if (locationField instanceof HTMLSelectElement) {
        locationField.value = selectedSide === "Frente" ? "Pecho" : selectedSide;
      }
      if (designField instanceof HTMLSelectElement) {
        designField.value = objectUrl ? "Tengo el diseño listo" : "Tengo una referencia";
      }
    });

    window.addEventListener("beforeunload", () => {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    });
  }
</script>

<style>
  .garment-window {
    animation: garment-arrive 650ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .garment-sprite {
    width: 200%;
    filter: brightness(0.2) contrast(1.22);
  }

  @keyframes garment-arrive {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garment-window {
      animation: none;
    }
  }
</style>
