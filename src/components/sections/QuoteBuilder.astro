---
import { contactConfig } from "../../data/contact";

const productOptions = [
  "Polera manga corta",
  "Polera manga larga",
  "Polerón",
  "Polera niños",
  "Tote bag",
  "Otros textiles",
];

const locationOptions = [
  "Pecho",
  "Espalda",
  "Manga",
  "Bolsillo",
  "Otra ubicación",
  "Por confirmar",
];

const sizeOptions = ["Por confirmar", "S", "M", "L", "XL", "XXL", "Infantil"];

const printSizeOptions = [
  "Por confirmar",
  "Pequeño",
  "Mediano",
  "Grande",
  "Cobertura amplia",
];

const designOptions = [
  "Tengo el diseño listo",
  "Tengo una referencia o idea",
  "Necesito orientación",
];

const inputClasses =
  "mt-2 min-h-11 w-full rounded-md border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-950 outline-none transition focus:border-neutral-950 focus:ring-2 focus:ring-neutral-950/10";
---

<section
  id="cotizador"
  class="border-t border-neutral-200 bg-neutral-50"
  aria-labelledby="cotizador-title"
>
  <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-normal text-neutral-500">
        Cotizador
      </p>
      <h2
        id="cotizador-title"
        class="mt-4 text-3xl font-semibold tracking-normal text-neutral-950 sm:text-4xl"
      >
        Prepara tu solicitud en menos de un minuto.
      </h2>
      <p class="mt-4 text-base leading-7 text-neutral-700">
        Completa los datos base del pedido y te entregaremos un mensaje ordenado
        para enviar por el canal disponible. No calcula precios automáticamente:
        la cotización depende del archivo, la prenda y la cantidad.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_0.86fr] lg:items-start">
      <form
        id="cotizador-form"
        class="rounded-lg border border-neutral-200 bg-white p-6 shadow-sm shadow-neutral-950/5 sm:p-8"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="text-sm font-semibold text-neutral-950">
            Producto
            <select id="quote-product" name="product" class={inputClasses} required>
              {
                productOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))
              }
            </select>
          </label>

          <label class="text-sm font-semibold text-neutral-950">
            Cantidad aproximada
            <input
              id="quote-quantity"
              name="quantity"
              class={inputClasses}
              type="number"
              min="1"
              step="1"
              value="1"
              required
            />
          </label>

          <label class="text-sm font-semibold text-neutral-950">
            Talla
            <select id="quote-size" name="size" class={inputClasses} required>
              {
                sizeOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))
              }
            </select>
          </label>

          <label class="text-sm font-semibold text-neutral-950">
            Color
            <input
              id="quote-color"
              name="color"
              class={inputClasses}
              type="text"
              placeholder="Ej: negro, blanco o por confirmar"
            />
          </label>

          <label class="text-sm font-semibold text-neutral-950">
            Ubicación del estampado
            <select id="quote-location" name="location" class={inputClasses} required>
              {
                locationOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))
              }
            </select>
          </label>

          <label class="text-sm font-semibold text-neutral-950">
            Tamaño aproximado
            <select id="quote-print-size" name="printSize" class={inputClasses} required>
              {
                printSizeOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))
              }
            </select>
          </label>
        </div>

        <fieldset class="mt-6 border-t border-neutral-200 pt-6">
          <legend class="text-base font-semibold text-neutral-950">Tus datos</legend>
          <p class="mt-1 text-sm leading-6 text-neutral-600">
            Los usaremos solo para responder esta solicitud de cotización.
          </p>

          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-semibold text-neutral-950">
              Nombre
              <input
                id="quote-client-name"
                name="clientName"
                class={inputClasses}
                type="text"
                autocomplete="name"
                placeholder="Tu nombre"
                required
              />
            </label>

            <label class="text-sm font-semibold text-neutral-950">
              Contacto
              <input
                id="quote-client-contact"
                name="clientContact"
                class={inputClasses}
                type="text"
                placeholder="WhatsApp o correo"
                required
              />
            </label>
          </div>

          <label class="mt-5 block text-sm font-semibold text-neutral-950">
            Canal preferido
            <select id="quote-channel" name="channel" class={inputClasses} required>
              <option value="WhatsApp">WhatsApp</option>
              <option value="Correo">Correo</option>
              <option value="Por confirmar">Por confirmar</option>
            </select>
          </label>
        </fieldset>

        <label class="mt-5 block text-sm font-semibold text-neutral-950">
          Estado del diseño
          <select id="quote-design" name="design" class={inputClasses} required>
            {
              designOptions.map((option) => (
                <option value={option}>{option}</option>
              ))
            }
          </select>
        </label>

        <label class="mt-5 block text-sm font-semibold text-neutral-950">
          Comentarios adicionales
          <textarea
            id="quote-notes"
            name="notes"
            class={inputClasses}
            rows="4"
            placeholder="Cuéntanos si necesitas una fecha, varias prendas o una ubicación distinta."
          ></textarea>
        </label>

        <button
          class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-md bg-neutral-950 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-950 focus-visible:ring-offset-2 sm:w-auto"
          type="submit"
        >
          Generar mensaje
        </button>
      </form>

      <aside
        class="rounded-lg bg-neutral-950 p-6 text-white shadow-xl shadow-neutral-950/10 sm:p-8"
        aria-labelledby="quote-output-title"
      >
        <p class="text-sm font-semibold uppercase tracking-normal text-neutral-400">
          Resultado
        </p>
        <h3 id="quote-output-title" class="mt-3 text-2xl font-semibold">
          Tu mensaje está aquí.
        </h3>
        <p class="mt-3 text-sm leading-6 text-neutral-300">
          Genera el resumen, revísalo y luego cópialo o envíalo cuando exista un
          canal configurado.
        </p>

        <textarea
          id="quote-output"
          class="mt-6 min-h-80 w-full resize-y rounded-md border border-white/10 bg-white/[0.08] p-4 text-sm leading-6 text-white outline-none placeholder:text-neutral-500 focus:border-white/40 focus:ring-2 focus:ring-white/10"
          rows="15"
          readonly
          placeholder="Aquí aparecerá el mensaje de cotización."
          aria-label="Mensaje de cotización generado"
        ></textarea>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <button
            id="copy-quote"
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-white px-5 py-3 text-center text-sm font-semibold text-neutral-950 transition-colors hover:bg-neutral-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 disabled:cursor-not-allowed disabled:bg-white/20 disabled:text-neutral-500"
            type="button"
            disabled
          >
            Copiar mensaje
          </button>

          <a
            id="whatsapp-quote"
            class="hidden min-h-11 items-center justify-center rounded-md border border-white/20 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Enviar por WhatsApp
          </a>

          <a
            id="email-quote"
            class="hidden min-h-11 items-center justify-center rounded-md border border-white/20 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
            href="#"
          >
            Enviar por correo
          </a>
        </div>

        <p
          id="quote-status"
          class="mt-4 min-h-6 text-sm leading-6 text-neutral-400"
          role="status"
          aria-live="polite"
        >
          Completa el formulario para preparar tu solicitud.
        </p>
      </aside>
    </div>
  </div>
</section>

<script
  define:vars={{
    configuredEmail: contactConfig.email,
    configuredWhatsapp: contactConfig.whatsappNumber,
  }}
>
  const form = document.querySelector("#cotizador-form");
  const output = document.querySelector("#quote-output");
  const copyButton = document.querySelector("#copy-quote");
  const whatsappLink = document.querySelector("#whatsapp-quote");
  const emailLink = document.querySelector("#email-quote");
  const status = document.querySelector("#quote-status");

  if (form && output && copyButton && whatsappLink && emailLink && status) {
    const getValue = (id) => {
      const field = form.elements.namedItem(id);
      return field && "value" in field ? String(field.value).trim() : "";
    };

    const buildMessage = () => {
      const quantity = getValue("quantity") || "Por confirmar";
      const color = getValue("color") || "Por confirmar";
      const notes = getValue("notes") || "Sin comentarios adicionales";

      return [
        "Hola, quiero cotizar un estampado personalizado DTF.",
        "",
        "Nombre: " + getValue("clientName"),
        "Contacto: " + getValue("clientContact"),
        "Canal preferido: " + getValue("channel"),
        "",
        "Producto: " + getValue("product"),
        "Cantidad aproximada: " + quantity,
        "Talla: " + getValue("size"),
        "Color: " + color,
        "Ubicación del estampado: " + getValue("location"),
        "Tamaño aproximado: " + getValue("printSize"),
        "Estado del diseño: " + getValue("design"),
        "Comentarios: " + notes,
      ].join("\n");
    };

    const cleanWhatsapp = configuredWhatsapp.replace(/\D/g, "");

    const productField = form.elements.namedItem("product");
    const productLinks = document.querySelectorAll(
      "[data-quote-product]"
    );

    productLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const product = link.dataset.quoteProduct;

        if (product && productField) {
          productField.value = product;
          status.textContent =
            "Producto seleccionado: " + product + ". Completa el resto del formulario.";
        }
      });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.reportValidity()) {
        return;
      }

      const message = buildMessage();
      output.value = message;
      copyButton.disabled = false;

      if (cleanWhatsapp) {
        whatsappLink.href =
          "https://wa.me/" + cleanWhatsapp + "?text=" + encodeURIComponent(message);
        whatsappLink.classList.remove("hidden");
      } else {
        whatsappLink.classList.add("hidden");
      }

      if (configuredEmail) {
        emailLink.href =
          "mailto:" +
          configuredEmail +
          "?subject=" +
          encodeURIComponent("Cotización de estampado DTF") +
          "&body=" +
          encodeURIComponent(message);
        emailLink.classList.remove("hidden");
      } else {
        emailLink.classList.add("hidden");
      }

      status.textContent =
        cleanWhatsapp || configuredEmail
          ? "Mensaje listo para revisar y enviar."
          : "Mensaje listo. Configura WhatsApp o correo en src/data/contact.ts para enviarlo.";
    });

    copyButton.addEventListener("click", async () => {
      if (!output.value) {
        return;
      }

      try {
        await navigator.clipboard.writeText(output.value);
        status.textContent = "Mensaje copiado al portapapeles.";
      } catch {
        output.focus();
        output.select();
        status.textContent = "Seleccioné el mensaje para que puedas copiarlo manualmente.";
      }
    });
  }
</script>
