---
import { contactConfig } from "../../data/contact";

const productOptions = [
  "Polera manga corta",
  "Polera manga larga",
  "Polerón",
  "Polera infantil",
  "Tote bag",
  "Otro textil",
];

const locationOptions = ["Pecho", "Espalda", "Manga", "Bolsillo", "Otra", "Por confirmar"];
const sizeOptions = ["Por confirmar", "S", "M", "L", "XL", "XXL", "Infantil"];
const printSizeOptions = ["Por confirmar", "Pequeño", "Mediano", "Grande", "Cobertura amplia"];
const designOptions = ["Tengo el diseño listo", "Tengo una referencia", "Necesito orientación"];

const inputClasses =
  "mt-2 min-h-11 w-full border-0 border-b border-neutral-400 bg-transparent px-0 py-2.5 text-sm text-neutral-950 outline-none transition placeholder:text-neutral-400 focus:border-neutral-950 focus:ring-0";
---

<section id="cotizador" class="bg-[#f4f1e9]" aria-labelledby="cotizador-title">
  <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[0.68fr_1.32fr] lg:gap-24 lg:py-28">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#ef4b32]">Cotizador</p>
      <h2
        id="cotizador-title"
        class="mt-5 text-5xl font-black leading-[0.88] tracking-[-0.065em] text-neutral-950 sm:text-6xl"
      >
        Hablemos de tu idea.
      </h2>
      <p class="mt-6 max-w-md text-base leading-7 text-neutral-600">
        Déjanos lo básico y generamos un mensaje listo para enviar. El precio final
        se confirma después de revisar el diseño.
      </p>

      <div class="mt-10 border-t border-neutral-400 text-sm">
        <details class="border-b border-neutral-400 py-4">
          <summary class="cursor-pointer font-bold">¿Qué archivo envío?</summary>
          <p class="mt-3 max-w-md leading-6 text-neutral-600">
            Idealmente PNG con fondo transparente y la mejor calidad disponible.
            Si solo tienes una referencia, también podemos partir por ahí.
          </p>
        </details>
        <details class="border-b border-neutral-400 py-4">
          <summary class="cursor-pointer font-bold">¿No sabes la talla o medida?</summary>
          <p class="mt-3 max-w-md leading-6 text-neutral-600">
            Marca “por confirmar”. Antes de producir revisamos contigo talla,
            ubicación y tamaño del estampado.
          </p>
        </details>
      </div>
    </div>

    <div>
      <form id="cotizador-form">
        <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          <label class="text-sm font-bold">
            Tu nombre
            <input name="clientName" class={inputClasses} type="text" autocomplete="name" placeholder="Nombre" required />
          </label>

          <label class="text-sm font-bold">
            WhatsApp o correo
            <input name="clientContact" class={inputClasses} type="text" placeholder="Cómo te respondemos" required />
          </label>

          <label class="text-sm font-bold">
            Producto
            <select name="product" class={inputClasses} required>
              {productOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>

          <label class="text-sm font-bold">
            Cantidad
            <input name="quantity" class={inputClasses} type="number" min="1" step="1" value="1" required />
          </label>

          <label class="text-sm font-bold">
            Talla
            <select name="size" class={inputClasses} required>
              {sizeOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>

          <label class="text-sm font-bold">
            Color
            <input name="color" class={inputClasses} type="text" placeholder="Ej: negro" />
          </label>

          <label class="text-sm font-bold">
            Ubicación
            <select name="location" class={inputClasses} required>
              {locationOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>

          <label class="text-sm font-bold">
            Tamaño del estampado
            <select name="printSize" class={inputClasses} required>
              {printSizeOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>

          <label class="text-sm font-bold sm:col-span-2">
            ¿En qué va tu diseño?
            <select name="design" class={inputClasses} required>
              {designOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>

          <label class="text-sm font-bold sm:col-span-2">
            Algo más que debamos saber
            <textarea
              name="notes"
              class={inputClasses}
              rows="3"
              placeholder="Fecha, varias tallas, otra prenda…"
            ></textarea>
          </label>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <button
            class="inline-flex min-h-12 items-center justify-center bg-neutral-950 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[#ef4b32]"
            type="submit"
          >
            Preparar mensaje
          </button>
          <p id="quote-status" class="text-sm text-neutral-500" role="status" aria-live="polite">
            No calcula ni cobra automáticamente.
          </p>
        </div>
      </form>

      <div id="quote-result" class="mt-10 hidden border-t-2 border-neutral-950 pt-7">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#ef4b32]">Mensaje listo</p>
            <h3 class="mt-2 text-2xl font-black tracking-tight">Revísalo y envíalo.</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="copy-quote" class="bg-neutral-950 px-4 py-2 text-sm font-bold text-white" type="button">
              Copiar
            </button>
            <a id="whatsapp-quote" class="hidden bg-[#ef4b32] px-4 py-2 text-sm font-bold text-white" href="#" target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
            <a id="email-quote" class="hidden border border-neutral-950 px-4 py-2 text-sm font-bold" href="#">
              Correo
            </a>
          </div>
        </div>
        <textarea
          id="quote-output"
          class="mt-5 min-h-64 w-full resize-y border border-neutral-400 bg-white p-4 text-sm leading-6 outline-none focus:border-neutral-950"
          rows="12"
          readonly
          aria-label="Mensaje de cotización generado"
        ></textarea>
      </div>
    </div>
  </div>
</section>

<script
  define:vars={{
    configuredEmail: contactConfig.email,
    configuredWhatsapp: contactConfig.whatsappNumber,
  }}
>
  const form = document.querySelector("#cotizador-form");
  const result = document.querySelector("#quote-result");
  const output = document.querySelector("#quote-output");
  const copyButton = document.querySelector("#copy-quote");
  const whatsappLink = document.querySelector("#whatsapp-quote");
  const emailLink = document.querySelector("#email-quote");
  const status = document.querySelector("#quote-status");

  if (form && result && output && copyButton && whatsappLink && emailLink && status) {
    const getValue = (name) => {
      const field = form.elements.namedItem(name);
      return field && "value" in field ? String(field.value).trim() : "";
    };

    const buildMessage = () => [
      "Hola, quiero cotizar un estampado DTF.",
      "",
      "Nombre: " + getValue("clientName"),
      "Contacto: " + getValue("clientContact"),
      "Producto: " + getValue("product"),
      "Cantidad: " + getValue("quantity"),
      "Talla: " + getValue("size"),
      "Color: " + (getValue("color") || "Por confirmar"),
      "Ubicación: " + getValue("location"),
      "Tamaño del estampado: " + getValue("printSize"),
      "Diseño: " + getValue("design"),
      "Comentarios: " + (getValue("notes") || "Sin comentarios adicionales"),
    ].join("\n");

    const cleanWhatsapp = configuredWhatsapp.replace(/\D/g, "");
    const productField = form.elements.namedItem("product");

    document.querySelectorAll("[data-quote-product]").forEach((link) => {
      link.addEventListener("click", () => {
        const product = link.dataset.quoteProduct;
        if (product && productField) {
          productField.value = product;
          result.classList.add("hidden");
          status.textContent = "Producto seleccionado. Completa tus datos para preparar el mensaje.";
        }
      });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const message = buildMessage();
      output.value = message;
      result.classList.remove("hidden");
      status.textContent = "Listo. Revisa el mensaje antes de enviarlo.";

      if (cleanWhatsapp) {
        whatsappLink.href = "https://wa.me/" + cleanWhatsapp + "?text=" + encodeURIComponent(message);
        whatsappLink.classList.remove("hidden");
      }

      if (configuredEmail) {
        emailLink.href = "mailto:" + configuredEmail + "?subject=" + encodeURIComponent("Cotización DTF") + "&body=" + encodeURIComponent(message);
        emailLink.classList.remove("hidden");
      }

      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        status.textContent = "Mensaje copiado.";
      } catch {
        output.focus();
        output.select();
        status.textContent = "Mensaje seleccionado para copiar manualmente.";
      }
    });
  }
</script>
