---
import DesignPreview from "../DesignPreview.astro";
---

<section id="inicio" class="overflow-hidden bg-[#f4f1e9]" aria-labelledby="inicio-title">
  <div class="mx-auto grid max-w-7xl lg:min-h-[46rem] lg:grid-cols-[0.95fr_1.05fr]">
    <div class="flex flex-col justify-center px-5 py-20 sm:px-8 lg:py-24">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#ef4b32]">
        Estampados DTF personalizados
      </p>
      <h1
        id="inicio-title"
        class="mt-6 max-w-3xl text-[clamp(4rem,9vw,7.8rem)] font-black leading-[0.78] tracking-[-0.085em] text-neutral-950"
      >
        Hazlo<br />tuyo.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-7 text-neutral-700">
        Estampamos poleras, polerones y textiles para tu marca, evento o idea.
        Tú traes el diseño; nosotros te ayudamos a aterrizarlo.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          class="inline-flex min-h-12 items-center justify-center bg-[#ef4b32] px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-neutral-950"
          href="#cotizador"
        >
          Cotizar un estampado
        </a>
        <a
          class="inline-flex min-h-12 items-center justify-center border-b-2 border-neutral-950 px-2 py-3 text-sm font-bold text-neutral-950 hover:text-[#ef4b32]"
          href="#catalogo"
        >
          Ver opciones ↓
        </a>
      </div>
    </div>

    <DesignPreview />
  </div>
</section>
