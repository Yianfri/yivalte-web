---
const trustItems = [
  {
    value: "DTF",
    label: "Color y detalle",
  },
  {
    value: "A medida",
    label: "Prenda, ubicación y cantidad",
  },
  {
    value: "Directo",
    label: "Revisión antes de producir",
  },
];

const requestDetails = [
  "Prenda o soporte textil",
  "Ubicación del estampado",
  "Archivo o referencia",
];
---

<section
  id="inicio"
  class="relative overflow-hidden border-b border-neutral-950 bg-neutral-950 text-white"
  aria-labelledby="inicio-title"
>
  <div
    class="pointer-events-none absolute -right-24 top-12 h-72 w-72 rounded-full bg-cyan-300"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 left-1/3 h-56 w-56 rotate-12 rounded-3xl bg-rose-300"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-6xl px-6 py-8 lg:py-12">
    <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-stretch">
      <div class="flex flex-col justify-between rounded-3xl border border-white/10 bg-neutral-950 p-6 sm:p-9">
        <div class="max-w-3xl">
          <div class="flex items-center gap-3">
            <span
              class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-300 text-sm font-bold text-neutral-950"
              aria-hidden="true"
            >
              Y
            </span>
            <p class="text-sm font-semibold uppercase tracking-wide text-cyan-300">
              Yivalte · estampados personalizados
            </p>
          </div>

          <h1
            id="inicio-title"
            class="mt-10 max-w-3xl text-5xl font-semibold leading-[0.95] tracking-tight text-white sm:text-7xl"
          >
            Tu idea,
            <span class="text-cyan-300">puesta</span>
            en la prenda.
          </h1>

          <p class="mt-7 max-w-2xl text-base leading-7 text-neutral-300 sm:text-lg">
            Personaliza poleras, polerones, tote bags y otros textiles con una
            cotización preparada según tu diseño, prenda, ubicación y cantidad.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-xl bg-cyan-300 px-5 py-3 text-center text-sm font-bold text-neutral-950 transition-colors hover:bg-cyan-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
              href="#cotizador"
            >
              Cotizar mi diseño
            </a>
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/20 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
              href="#catalogo"
            >
              Ver catálogo
            </a>
          </div>
        </div>

        <dl class="mt-12 grid gap-3 sm:grid-cols-3">
          {
            trustItems.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4">
                <dt class="text-base font-bold text-cyan-300">{item.value}</dt>
                <dd class="mt-1 text-xs leading-5 text-neutral-400">{item.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <aside
        class="relative overflow-hidden rounded-3xl bg-white p-5 text-neutral-950 shadow-2xl shadow-black/30 sm:p-7"
        aria-label="Vista referencial de un pedido DTF"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-bold text-neutral-950">Vista previa del pedido</p>
            <p class="mt-1 text-xs leading-5 text-neutral-500">
              Así parte una cotización.
            </p>
          </div>
          <span class="rounded-full bg-neutral-950 px-3 py-1 text-xs font-bold text-white">
            01
          </span>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl bg-neutral-100 p-5">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-bold uppercase tracking-wide text-neutral-500">
              Mockup referencial
            </span>
            <span class="h-2 w-12 rounded-full bg-cyan-300" aria-hidden="true"></span>
          </div>

          <div class="relative mx-auto mt-7 h-56 max-w-[18rem]" aria-hidden="true">
            <span class="absolute left-2 top-16 h-24 w-16 -rotate-12 rounded-xl border border-neutral-300 bg-white"></span>
            <span class="absolute right-2 top-16 h-24 w-16 rotate-12 rounded-xl border border-neutral-300 bg-white"></span>
            <span class="absolute left-1/2 top-5 z-10 h-44 w-36 -translate-x-1/2 rounded-2xl border border-neutral-300 bg-white shadow-xl shadow-neutral-950/10"></span>
            <span class="absolute left-1/2 top-5 z-20 h-10 w-16 -translate-x-1/2 rounded-b-full border-b border-neutral-300 bg-neutral-100"></span>
            <span class="absolute left-1/2 top-24 z-20 grid h-16 w-16 -translate-x-1/2 place-items-center rounded-xl bg-neutral-950 text-2xl font-bold text-cyan-300">
              Y
            </span>
            <span class="absolute bottom-7 left-1/2 z-20 h-2 w-28 -translate-x-1/2 rounded-full bg-cyan-300"></span>
            <span class="absolute bottom-3 left-1/2 z-20 h-2 w-20 -translate-x-1/2 rounded-full bg-neutral-300"></span>
          </div>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          {
            requestDetails.map((detail, index) => (
              <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
                <p class="text-[11px] font-bold uppercase tracking-wide text-neutral-400">
                  Dato 0{index + 1}
                </p>
                <p class="mt-2 text-sm font-semibold leading-5 text-neutral-950">
                  {detail}
                </p>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </div>
</section>
