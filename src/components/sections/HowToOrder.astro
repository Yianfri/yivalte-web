---
const steps = [
  ["01", "Cuéntanos", "Prenda, cantidad y dónde quieres el estampado."],
  ["02", "Lo revisamos", "Miramos tu archivo y aclaramos lo que falte."],
  ["03", "Confirmamos", "Te damos el valor y coordinamos producción y entrega."],
];
---

<section id="como-pedir" class="bg-[#9fd8c5]" aria-labelledby="como-pedir-title">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-20">
    <div class="flex flex-col gap-5 border-b-2 border-neutral-950 pb-7 sm:flex-row sm:items-end sm:justify-between">
      <h2 id="como-pedir-title" class="text-4xl font-black tracking-[-0.055em] sm:text-5xl">
        Sin vueltas.
      </h2>
      <p class="max-w-md text-sm leading-6 text-neutral-800">
        No necesitas llegar con todo resuelto. Una referencia o una idea también sirve.
      </p>
    </div>

    <ol class="grid md:grid-cols-3">
      {
        steps.map(([number, title, description]) => (
          <li class="border-b border-neutral-950/30 py-7 md:border-b-0 md:border-r md:px-7 md:first:pl-0 md:last:border-r-0 md:last:pr-0">
            <span class="text-xs font-black">{number}</span>
            <h3 class="mt-8 text-2xl font-black tracking-tight">{title}</h3>
            <p class="mt-2 max-w-xs text-sm leading-6 text-neutral-800">{description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
