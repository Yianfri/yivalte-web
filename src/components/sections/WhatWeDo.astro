---
import Card from "../Card.astro";
import SectionHeading from "../SectionHeading.astro";

const highlights = [
  {
    title: "Prendas para personalizar",
    description:
      "Trabajamos con poleras manga corta y larga, poleras infantiles y polerones.",
  },
  {
    title: "Archivo listo para revisar",
    description:
      "El formato requerido es PNG. Si hace falta quitar el fondo o mejorar la calidad, lo revisamos sin costo adicional.",
  },
  {
    title: "Cotización según tu pedido",
    description:
      "Consideramos la prenda, ubicación, tamaño del estampado y cantidad antes de confirmar.",
  },
];

const ideas = [
  "Polera manga corta para logos, frases e ilustraciones",
  "Polera manga larga o polerón para diseños con mayor presencia",
  "Polera infantil manga corta para pedidos personalizados",
];
---

<section
  id="que-hacemos"
  class="border-t border-neutral-200 bg-neutral-50"
  aria-labelledby="que-hacemos-title"
>
  <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1fr] lg:items-start">
      <SectionHeading
        eyebrow="Servicio"
        title="Tu idea pasa de archivo a prenda sin vueltas."
        titleId="que-hacemos-title"
        intro="Yivalte prepara estampados DTF para prendas y productos textiles. Revisamos los datos importantes del pedido para que puedas cotizar con claridad."
      />

      <Card variant="white" class="p-6">
        <h3 class="text-lg font-semibold text-neutral-950">
          Lo que puedes personalizar
        </h3>
        <ul class="mt-5 grid gap-3">
          {
            ideas.map((idea) => (
              <li class="flex gap-3 text-sm leading-6 text-neutral-700">
                <span
                  class="mt-2 h-2 w-2 shrink-0 rounded-full bg-cyan-400"
                  aria-hidden="true"
                />
                <span>{idea}</span>
              </li>
            ))
          }
        </ul>
      </Card>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        highlights.map((item) => (
          <Card>
            <h3 class="text-base font-semibold text-neutral-950">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-neutral-700">
              {item.description}
            </p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
