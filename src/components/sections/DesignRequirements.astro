---
import Card from "../Card.astro";
import SectionHeading from "../SectionHeading.astro";

const requirements = [
  "PNG obligatorio cuando el diseño ya esté listo.",
  "Buena calidad para conservar los detalles del estampado.",
  "Fondo transparente ideal; si hace falta, ayudamos a retirarlo sin costo adicional.",
  "Indicar si el estampado irá en pecho, espalda, manga, bolsillo u otra ubicación.",
  "Definir una referencia de tamaño: pequeño, mediano, grande o medida aproximada.",
  "Si son varias prendas, indicar cantidades y tallas de cada una.",
];
---

<section
  id="requisitos-diseno"
  class="border-t border-neutral-200 bg-neutral-50"
  aria-labelledby="requisitos-diseno-title"
>
  <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.82fr_1fr] lg:items-start">
      <SectionHeading
        eyebrow="Requisitos del diseño"
        title="Mándanos el archivo. Nosotros revisamos el resto."
        titleId="requisitos-diseno-title"
        intro="El formato requerido es PNG y conviene enviarlo con la mejor calidad disponible. Si el diseño necesita un ajuste básico de fondo o calidad, lo revisamos antes de producir."
      />

      <ul class="grid gap-3">
        {
          requirements.map((requirement) => (
            <Card as="li" class="flex gap-3">
              <span
                class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-neutral-950 text-[10px] font-semibold text-white"
                aria-hidden="true"
              >
                ✓
              </span>
              <span class="text-sm leading-6 text-neutral-700">
                {requirement}
              </span>
            </Card>
          ))
        }
      </ul>
    </div>
  </div>
</section>
