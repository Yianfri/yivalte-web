---
import { contactConfig } from "../../data/contact";
import WhatsAppButton from "../WhatsAppButton.astro";

const hasConfiguredContact =
  Boolean(contactConfig.whatsappNumber) || Boolean(contactConfig.instagramUrl);

const contactDetails = [
  "Tipo de prenda o producto textil",
  "Cantidad aproximada",
  "Ubicación del estampado",
  "Tamaño aproximado",
  "Archivo o referencia del diseño",
];

const trustNotes = [
  "Respuesta guiada por los datos del pedido",
  "Archivo revisado antes de confirmar",
  "Coordinación por canales configurables",
];

const shippingDetails = [
  { label: "Desde 4 unidades", value: "Envío gratis" },
  { label: "Santiago", value: "$2.990" },
  { label: "Regiones", value: "$4.990" },
];
---

<section
  id="contacto"
  class="border-t border-neutral-200 bg-white"
  aria-labelledby="contacto-title"
>
  <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
    <div class="rounded-lg border border-neutral-200 bg-neutral-950 p-6 text-white shadow-xl shadow-neutral-950/10 lg:p-8">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div class="space-y-5">
          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-normal text-neutral-400">
              Contacto
            </p>
            <h2
              id="contacto-title"
              class="text-3xl font-semibold tracking-normal text-white sm:text-4xl"
            >
              Envía tu idea y cotizamos tu estampado.
            </h2>
            <p class="max-w-2xl text-base leading-7 text-neutral-300">
              Cuando los canales estén configurados, podrás iniciar la conversación
              por WhatsApp o Instagram con los datos base del pedido.
            </p>
          </div>

          <ul class="grid gap-2 text-sm text-neutral-300 sm:grid-cols-2">
            {
              contactDetails.map((detail) => (
                <li class="flex gap-2">
                  <span class="text-cyan-300" aria-hidden="true">•</span>
                  <span>{detail}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex w-full flex-col gap-3 sm:w-auto">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-cyan-300 px-5 py-3 text-center text-sm font-semibold text-neutral-950 transition-colors hover:bg-cyan-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
            href="#cotizador"
          >
            Preparar cotización
          </a>
          {
            hasConfiguredContact ? (
              <WhatsAppButton tone="inverted" />
            ) : (
              <p class="max-w-xs text-center text-xs leading-5 text-neutral-400 sm:text-right">
                El contacto directo se habilitará cuando configuremos los canales de atención.
              </p>
            )
          }
        </div>
      </div>

      <div class="mt-8 grid gap-6 border-t border-white/10 pt-6 md:grid-cols-[1fr_1fr]">
        <ul class="grid gap-3 sm:grid-cols-3">
          {
            trustNotes.map((note) => (
              <li class="rounded-lg bg-white/[0.08] p-4 text-sm leading-6 text-neutral-300">
                {note}
              </li>
            ))
          }
        </ul>

        <div class="rounded-lg border border-white/10 bg-white/[0.05] p-4">
          <p class="text-sm font-semibold uppercase tracking-normal text-cyan-300">
            Envíos
          </p>
          <div class="mt-3 grid gap-2 text-sm text-neutral-300 sm:grid-cols-3 md:grid-cols-1">
            {
              shippingDetails.map((shipping) => (
                <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-2 last:border-0 last:pb-0">
                  <span>{shipping.label}</span>
                  <span class="font-semibold text-white">{shipping.value}</span>
                </div>
              ))
            }
          </div>
          <p class="mt-3 text-xs leading-5 text-neutral-400">
            Valores referenciales; se confirman al coordinar el pedido.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
