---
const productOptions = [
  { title: "Polera manga corta", detail: "Pecho, espalda o detalle pequeño", price: "Desde $9.990" },
  { title: "Polera manga larga", detail: "Frente, espalda o mangas", price: "A cotizar" },
  { title: "Polerón", detail: "Pecho, espalda o bolsillo", price: "Desde $16.990" },
  { title: "Polera infantil", detail: "Tallas infantiles por confirmar", price: "A cotizar" },
  { title: "Tote bag", detail: "Una o dos caras según diseño", price: "A cotizar" },
  { title: "Otro textil", detail: "Lo revisamos según material", price: "A cotizar" },
];
---

<section id="catalogo" class="bg-white" aria-labelledby="catalogo-title">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#ef4b32]">Qué hacemos</p>
        <h2
          id="catalogo-title"
          class="mt-5 text-5xl font-black leading-[0.9] tracking-[-0.06em] text-neutral-950 sm:text-6xl"
        >
          Elige la base.<br />El diseño es tuyo.
        </h2>
        <p class="mt-6 max-w-md text-base leading-7 text-neutral-600">
          Trabajamos cada pedido según cantidad, tamaño del estampado y archivo.
          Estos valores son una referencia para partir.
        </p>
      </div>

      <ol class="border-t-2 border-neutral-950">
        {
          productOptions.map((product, index) => (
            <li class="group grid grid-cols-[2.5rem_1fr] gap-3 border-b border-neutral-300 py-5 sm:grid-cols-[3rem_1fr_auto] sm:items-center">
              <span class="text-xs font-bold text-[#ef4b32]">0{index + 1}</span>
              <div>
                <h3 class="text-xl font-bold tracking-tight text-neutral-950 sm:text-2xl">
                  {product.title}
                </h3>
                <p class="mt-1 text-sm text-neutral-500">{product.detail}</p>
              </div>
              <div class="col-start-2 flex items-center justify-between gap-5 sm:col-start-auto">
                <span class="text-sm font-bold text-neutral-950">{product.price}</span>
                <a
                  class="text-xl font-bold text-neutral-950 transition-transform group-hover:translate-x-1"
                  href="#cotizador"
                  data-quote-product={product.title}
                  aria-label={`Cotizar ${product.title}`}
                >
                  →
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
