---
const navigationItems = [
  { label: "Prueba tu diseño", href: "#probador" },
  { label: "Productos", href: "#catalogo" },
  { label: "Cómo funciona", href: "#como-pedir" },
];
---

<header class="sticky top-0 z-50 border-b border-black/10 bg-[#f4f1e9]/95 backdrop-blur">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-8"
    aria-label="Navegación principal"
  >
    <a href="#inicio" aria-label="Yivalte, inicio">
      <img
        class="h-9 w-auto brightness-0"
        src="/brand/yivalte-wordmark.svg"
        alt="Yivalte"
        width="896"
        height="405"
      />
    </a>

    <ul class="hidden items-center gap-7 text-sm font-medium md:flex">
      {
        navigationItems.map((item) => (
          <li>
            <a class="transition-colors hover:text-[#ef4b32]" href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      class="inline-flex min-h-10 items-center justify-center bg-neutral-950 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-[#ef4b32]"
      href="#cotizador"
    >
      Cuéntanos tu idea
    </a>
  </nav>
</header>
