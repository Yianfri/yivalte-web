---
const navigationItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Servicio", href: "#que-hacemos" },
  { label: "Catálogo", href: "#catalogo" },
  { label: "Cómo pedir", href: "#como-pedir" },
  { label: "Archivos", href: "#requisitos-diseno" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-neutral-950/95 text-white backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-4 lg:flex-row lg:items-center lg:justify-between"
    aria-label="Navegación principal"
  >
    <a class="flex items-center gap-3" href="#inicio" aria-label="Yivalte inicio">
      <span
        class="grid h-10 w-10 place-items-center rounded-xl bg-cyan-300 text-sm font-bold text-neutral-950"
        aria-hidden="true"
      >
        Y
      </span>
      <span class="text-lg font-bold tracking-tight text-white">Yivalte</span>
    </a>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          navigationItems.map((item) => (
            <li>
              <a
                class="rounded-sm text-neutral-300 transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-4 focus-visible:ring-offset-neutral-950"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        class="inline-flex min-h-10 items-center justify-center rounded-xl bg-cyan-300 px-4 py-2 text-center text-sm font-bold text-neutral-950 transition-colors hover:bg-cyan-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950 sm:w-auto"
        href="#cotizador"
      >
        Cotizar ahora
      </a>
    </div>
  </nav>
</header>
